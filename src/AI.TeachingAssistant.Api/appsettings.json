{
  "ConnectionStrings": {
    "Default": "Data Source=madreseai.db"
  },
  "AI": {
    "Provider": "mock",
    "ApiKey": "",
    "BaseUrl": "https://api.xkiro.com/v1",
    "Model": "qwen/qwen3.5-flash:free",
    "FallbackModel": "qwen/qwen3.7-flash:free",
    "TimeoutSeconds": 110,
    "MaxTokens": 3000
  },
  "ImageGeneration": {
    "Provider": "",
    "Model": "sensenova/sensenova-u1.5-lite",
    "BaseUrl": "https://api.xkiro.com/v1",
    "Size": "1024x1024",
    "PollTimeoutSeconds": 300,
    "MaxImagesPerSection": 2
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
