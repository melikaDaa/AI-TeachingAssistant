@* ---------- Media prompt card (image + video) ---------- *@

<div class="prompt-card">
    <div class="prompt-head">
        <h3>@Title</h3>
        <button type="button" class="btn ghost small" @onclick="CopyPrompt">
            <Icon Name="IconName.Copy" Size="15" /> کپی پرامپت
        </button>
    </div>

    @if (_copied)
    {
        <div class="edited-note"><Icon Name="IconName.Check" Size="14" /> کپی شد</div>
    }

    @if (Image is not null)
    {
        <dl class="prompt-attrs">
            <dt>موضوع تصویر</dt><dd>@Image.Subject</dd>
            <dt>عناصر بصری</dt><dd>@Image.VisualElements</dd>
            <dt>سبک</dt><dd>@Image.Style</dd>
            <dt>ترکیب‌بندی</dt><dd>@Image.Composition</dd>
            <dt>هدف آموزشی</dt><dd>@Image.EducationalPurpose</dd>
            <dt>محدودیت متن</dt><dd>@Image.TextRestrictions</dd>
        </dl>
    }
    else if (Video is not null)
    {
        <dl class="prompt-attrs">
            <dt>توصیف صحنه</dt><dd>@Video.SceneDescription</dd>
            <dt>شخصیت‌ها / اشیاء</dt><dd>@Video.Characters</dd>
            <dt>محیط</dt><dd>@Video.Environment</dd>
            <dt>دوربین</dt><dd>@Video.Camera</dd>
            <dt>حرکت</dt><dd>@Video.Motion</dd>
            <dt>مدت</dt><dd>@Video.Duration</dd>
            <dt>هدف آموزشی</dt><dd>@Video.EducationalObjective</dd>
            <dt>سبک بصری</dt><dd>@Video.VisualStyle</dd>
        </dl>
    }

    <div class="prompt-box">@FinalPrompt</div>
    <p class="prompt-hint">این پرامپت را می‌توانید در ابزارهای تولید @(Image is not null ? "تصویر" : "ویدئو مانند Google Flow") استفاده کنید.</p>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public ImagePromptDto? Image { get; set; }
    [Parameter] public VideoPromptDto? Video { get; set; }

    [Inject] private IJSRuntime JS { get; set; } = null!;

    private bool _copied;

    private string FinalPrompt =>
        Image?.FinalPrompt ?? Video?.FinalPrompt ?? string.Empty;

    // Per-prompt copy button (spec §13/§14): copies the final English prompt.
    private async Task CopyPrompt()
    {
        if (string.IsNullOrWhiteSpace(FinalPrompt)) return;
        await JS.InvokeVoidAsync("copyToClipboard", FinalPrompt);
        _copied = true;
    }
}
