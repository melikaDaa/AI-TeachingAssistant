@* ---------- مدرس‌یار Brand Mark ----------
   Uses the official madrese-assistant.png with transparent background. *@
<img class="brandmark @CssClass" src="assets/madrese-assistant.png" alt="نماد مدرس‌یار" width="@Size" height="@Size" role="img" aria-label="نماد مدرس‌یار" focusable="false" />

@code {
    [Parameter, EditorRequired] public int Size { get; set; } = 28;

    [Parameter] public string? CssClass { get; set; }
}
