@using System.Text.Json
@using AI.TeachingAssistant.Web.Extensions
@implements IDisposable
@inject MadreseAIApiClient Api
@inject IJSRuntime JS

<div class="tabs" role="tablist">
    @foreach (var s in SectionMeta.All)
    {
        var has = HasSection(s.Code);
        <button type="button" class="tab @(ActiveKey == s.Key ? "active" : "")" @onclick="() => Activate(s.Key)">
            @s.Emoji @s.Title
            @if (has)
            {
                <span class="dot">●</span>
            }
        </button>
    }
</div>

@if (_error is not null)
{
    <div class="error-banner">@_error</div>
}

@if (Package.Progress.Status is "generating" or "draft")
{
    <div class="progress-wrap card">
        <div class="progress-ring"></div>
        <div class="progress-msg">✨ مدرس‌یار در حال آماده‌سازی کلاس شماست</div>
        <div class="progress-sub">این کار ممکن است کمی طول بکشد؛ همین صفحه به‌صورت خودکار به‌روزرسانی می‌شود.</div>
        <div class="progress-steps">
            <span class="pill done">✓ اطلاعات کلاس بررسی شد</span>
            <span class="pill done">✓ ساختار درس آماده شد</span>
            @foreach (var s in SectionMeta.All)
            {
                var done = CompletedKeys.Contains(s.Key);
                var current = CurrentSectionKey == s.Key;
                <span class="pill @(done ? "done" : (current ? "current" : ""))">
                    @if (done)
                    {
                        <text>✓ </text>
                    }
                    else
                    {
                        <text>○ </text>
                    }
                    @s.Title
                </span>
            }
        </div>
    </div>
}
else if (Package.Progress.Status == "failed")
{
    <div class="error-banner">
        @(Package.Progress.Error ?? "در تولید محتوا مشکلی پیش آمد. لطفاً دوباره تلاش کنید.")
    </div>
    <div class="section-toolbar">
        <button type="button" class="btn small" @onclick="RegenerateCurrent">🔄 تلاش دوباره برای «@(ActiveSection?.Title)»</button>
    </div>
}
else
{
    <div class="card">
        @switch (ActiveKey)
        {
            case "lesson-plan" when Package.LessonPlan is not null:
                <LessonPlanView Plan="Package.LessonPlan" />
                break;
            case "content" when Package.EducationalContent is not null:
                <EducationalContentView Content="Package.EducationalContent" />
                break;
            case "activity" when Package.Activity is not null:
                <ActivityView Activity="Package.Activity" />
                break;
            case "quiz" when Package.Quiz is not null:
                <QuizView Quiz="Package.Quiz" />
                break;
            case "image-prompt" when Package.Media.ImagePrompts.Count > 0:
                <h2>پرامپت‌های تصویر</h2>
                @foreach (var img in Package.Media.ImagePrompts)
                {
                    <PromptCard Title="@img.Title" Image="@img" />
                }
                break;
            case "video-prompt" when Package.Media.VideoPrompt is not null:
                <PromptCard Title="@Package.Media.VideoPrompt.Title" Video="@Package.Media.VideoPrompt" />
                break;
            default:
                <div class="empty">
                    <span class="big">✨</span>
                    این بخش هنوز ساخته نشده است.
                    <div style="margin-top:.6rem">
                        <button type="button" class="btn small" @onclick="RegenerateCurrent">✨ ساخت همین بخش</button>
                    </div>
                </div>
                break;
        }
    </div>

    @if (ActiveSection is not null && HasSection(ActiveSection.Code))
    {
        <div class="section-toolbar">
            <button type="button" class="btn ghost small" @onclick="CopyActive">📋 کپی متن</button>
            @if (CanEditActive)
            {
                <button type="button" class="btn ghost small" @onclick="StartEdit">✏️ ویرایش</button>
            }
            <button type="button" class="btn ghost small" @onclick="RegenerateCurrent">🔄 تولید مجدد این بخش</button>
            <span class="spacer"></span>
            @if (_copyState == CopyState.Copied)
            {
                <span class="edited-note">✓ کپی شد</span>
            }
            @if (_saveState == SaveState.Saved)
            {
                <span class="edited-note">✓ ذخیره شد</span>
            }
        </div>

        @if (_editing)
        {
            <div class="edit-note">
                متن‌ها را آزادانه تغییر دهید؛ ساختار JSON را حفظ کنید. پس از اتمام «ذخیره» را بزنید.
            </div>
            <textarea class="payload-editor" @bind="_payload"></textarea>
            <div class="section-toolbar">
                <button type="button" class="btn small" @onclick="SaveEdit">💾 ذخیره</button>
                <button type="button" class="btn ghost small" @onclick="() => _editing = false">انصراف</button>
            </div>
        }
    }
}

@code {
    private enum SaveState { Clean, Saved }
    private enum CopyState { None, Copied }

    [Parameter, EditorRequired] public TeachingPackageDto Package { get; set; } = null!;

    private string _activeKey = "lesson-plan";
    private bool _editing;
    private string _payload = string.Empty;
    private SaveState _saveState = SaveState.Clean;
    private CopyState _copyState = CopyState.None;
    private string? _error;
    private System.Timers.Timer? _pollTimer;
    private int _pollSeq;

    private string ActiveKey
    {
        get => _activeKey;
        set
        {
            _activeKey = value;
            _editing = false;
            _saveState = SaveState.Clean;
            _copyState = CopyState.None;
        }
    }

    private SectionMeta.Info? ActiveSection => SectionMeta.ByKey(ActiveKey);

    private bool CanEditActive => ActiveSection?.Code is 1 or 2 or 3 or 4;

    private List<string> CompletedKeys => Package.Progress.CompletedSections
        .Select(c => int.TryParse(c, out var n) ? n : 0)
        .Where(n => n > 0)
        .Select(SectionMeta.ByCode)
        .Select(s => s.Key)
        .ToList();

    private string CurrentSectionKey
    {
        get
        {
            var byName = SectionMeta.All.FirstOrDefault(s => s.Title == Package.Progress.CurrentSection)?.Key;
            if (byName is not null) return byName;
            var last = CompletedKeys.LastOrDefault();
            if (last is not null)
            {
                var list = SectionMeta.All.ToList();
                var idx = list.FindIndex(s => s.Key == last);
                if (idx >= 0 && idx + 1 < list.Count) return list[idx + 1].Key;
            }
            return SectionMeta.All[0].Key;
        }
    }

    private string CurrentProgressMessage =>
        SectionMeta.ByKey(CurrentSectionKey)?.ProgressMessage ?? "در حال آماده‌سازی محتوا...";

    private int ParseCode(string key) => SectionMeta.ByKey(key)?.Code ?? 0;

    private bool HasSection(int code) => code switch
    {
        1 => Package.LessonPlan is not null,
        2 => Package.EducationalContent is not null,
        3 => Package.Activity is not null,
        4 => Package.Quiz is not null,
        5 => Package.Media.ImagePrompts.Count > 0,
        6 => Package.Media.VideoPrompt is not null,
        _ => false,
    };

    private void Activate(string key)
    {
        ActiveKey = key;
    }

    public void StartPolling()
    {
        if (_pollTimer is not null) return;
        _pollTimer = new System.Timers.Timer(1500) { AutoReset = true };
        _pollTimer.Elapsed += async (_, _) =>
        {
            var seq = Interlocked.Increment(ref _pollSeq);
            try
            {
                var fresh = await Api.GetLessonAsync(Package.LessonId);
                if (fresh is not null && seq == Volatile.Read(ref _pollSeq))
                {
                    Package = fresh;
                    await InvokeAsync(StateHasChanged);
                    if (Package.Progress.Status is "ready" or "failed")
                    {
                        StopPolling();
                    }
                }
            }
            catch
            {
                // transient polling errors are ignored; the next tick retries
            }
        };
        _pollTimer.Start();
    }

    public void StopPolling()
    {
        _pollTimer?.Stop();
        _pollTimer?.Dispose();
        _pollTimer = null;
    }

    public void Dispose() => StopPolling();

    private async Task CopyActive()
    {
        var text = ActiveKey switch
        {
            "lesson-plan" when Package.LessonPlan is not null => TextExport.LessonPlan(Package.LessonPlan),
            "content" when Package.EducationalContent is not null => TextExport.EducationalContent(Package.EducationalContent),
            "activity" when Package.Activity is not null => TextExport.Activity(Package.Activity),
            "quiz" when Package.Quiz is not null => TextExport.Quiz(Package.Quiz),
            "image-prompt" => string.Join("\n\n———\n\n", Package.Media.ImagePrompts.Select(TextExport.ImagePrompt)),
            "video-prompt" when Package.Media.VideoPrompt is not null => TextExport.VideoPrompt(Package.Media.VideoPrompt),
            _ => string.Empty,
        };

        if (string.IsNullOrEmpty(text)) return;
        await JS.InvokeVoidAsync("copyToClipboard", text);
        _copyState = CopyState.Copied;
    }

    private static readonly JsonSerializerOptions JsonOpts = new()
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        WriteIndented = true,
    };

    private void StartEdit()
    {
        _payload = ActiveKey switch
        {
            "lesson-plan" => JsonSerializer.Serialize(Package.LessonPlan, JsonOpts),
            "content" => JsonSerializer.Serialize(Package.EducationalContent, JsonOpts),
            "activity" => JsonSerializer.Serialize(Package.Activity, JsonOpts),
            "quiz" => JsonSerializer.Serialize(Package.Quiz, JsonOpts),
            _ => "{}",
        };
        _editing = true;
        _saveState = SaveState.Clean;
        _error = null;
    }

    private async Task SaveEdit()
    {
        _error = null;
        try
        {
            var fresh = await Api.SaveSectionAsync(Package.LessonId, ActiveKey, _payload);
            if (fresh is not null) Package = fresh;
            _editing = false;
            _saveState = SaveState.Saved;
        }
        catch (MadreseAIApiException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task RegenerateCurrent()
    {
        _error = null;
        try
        {
            await Api.StartSectionGenerationAsync(Package.LessonId, ActiveKey);
            Package = Package with
            {
                Progress = new GenerationProgressDto("generating", ActiveSection?.Title ?? "", Package.Progress.CompletedSections, null),
            };
            StartPolling();
        }
        catch (MadreseAIApiException ex)
        {
            _error = ex.Message;
        }
    }
}
