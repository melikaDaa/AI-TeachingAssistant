@page "/lessons"
@inject MadreseAIApiClient Api
@inject IJSRuntime JS

<PageTitle>مدرس‌یار — محتوای من</PageTitle>

<div class="page-head">
    <div class="grow">
        <h1>محتوای من</h1>
        <p class="page-sub">آرشیو کلاس‌هایی که با کمک مدرس‌یار آماده کرده‌اید.</p>
    </div>
    <a class="btn" href="/lessons/new"><Icon Name="IconName.Plus" Size="17" /> ساخت محتوای جدید</a>
</div>

@if (_error is not null)
{
    <div class="error-banner" role="alert"><Icon Name="IconName.Bell" Size="17" /> @_error</div>
}

@if (_lessons is null)
{
    <div class="empty"><span class="big"><Icon Name="IconName.Loader" Size="26" CssClass="spin" /></span>در حال بارگذاری...</div>
}
else if (_lessons.Count == 0)
{
    <div class="empty">
        <span class="big"><img src="assets/madrese-assistant.png" alt="" style="width:80px;height:80px" /></span>
        <h2>هنوز محتوایی نساخته‌اید</h2>
        <p>اولین محتوای آموزشی‌ات را با کمک من بساز.</p>
        <a class="btn" href="/lessons/new"><Icon Name="IconName.Plus" Size="17" /> ساخت اولین محتوا</a>
    </div>
}
else
{
    <div class="grid">
        @foreach (var lesson in _lessons)
        {
            <div class="lesson-row">
                <span class="card-icon" aria-hidden="true">
                    <span style="width:2.2rem; height:2.2rem; display:inline-flex; align-items:center; justify-content:center; background:var(--primary-50); color:var(--primary); border-radius:var(--radius-sm)">
                        <Icon Name="IconName.Lesson" Size="19" />
                    </span>
                </span>
                <div class="grow">
                    <h3>@lesson.Title</h3>
                    <div class="meta">
                        <span>@lesson.Subject</span>
                        <span>·</span>
                        <span>@lesson.Topic</span>
                        <span>·</span>
                        <span>پایه @lesson.Grade</span>
                        <span>·</span>
                        <span><Icon Name="IconName.Time" Size="14" /> @lesson.DurationMinutes.ToPersianDigits() دقیقه</span>
                        <span>·</span>
                        <span>@lesson.CreatedAt.PersianDate()</span>
                    </div>
                </div>
                <span class="badge @DtoMapper.StatusKey(lesson.Status)">@PersianText.StatusLabel(DtoMapper.StatusKey(lesson.Status))</span>
                <div class="actions">
                    <a class="btn small" href="@($"/lessons/{lesson.Id}")">مشاهده</a>
                    <button type="button" class="link-danger" @onclick="() => ConfirmDeleteAsync(lesson.Id)">
                        <Icon Name="IconName.Trash" Size="15" /> حذف
                    </button>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<LessonSummaryDto>? _lessons;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _lessons = await Api.GetLessonsAsync();
        }
        catch (MadreseAIApiException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task ConfirmDeleteAsync(int id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "آیا مطمئن هستید که می‌خواهید این درس را حذف کنید؟"))
            return;
        await DeleteAsync(id);
    }

    private async Task DeleteAsync(int id)
    {
        _error = null;
        try
        {
            await Api.DeleteLessonAsync(id);
            _lessons = await Api.GetLessonsAsync();
        }
        catch (MadreseAIApiException ex)
        {
            _error = ex.Message;
        }
    }
}
