@page "/lessons/{Id:int}"
@inject MadreseAIApiClient Api

<PageTitle>مدرس‌یار — بسته آموزشی</PageTitle>

@if (_error is not null)
{
    <div class="error-banner" role="alert"><Icon Name="IconName.Bell" Size="17" /> @_error</div>
    <a class="btn ghost" href="/lessons">بازگشت به درس‌ها <Icon Name="IconName.ArrowRight" Size="16" /></a>
}
else if (_package is null)
{
    <div class="empty"><span class="big"><Icon Name="IconName.Loader" Size="26" CssClass="spin" /></span>در حال بارگذاری...</div>
}
else if (_package.Progress.Status == "ready")
{
    <div class="page-head">
        <div class="grow">
            <h1>@_package.LessonTitle</h1>
            <p class="page-sub">محتوای آماده‌ی کلاس — مدرس‌یار ساخته، شما بازبینی و ویرایش می‌کنید.</p>
        </div>
        <a class="btn ghost" href="/lessons">محتوای من <Icon Name="IconName.ArrowRight" Size="16" /></a>
    </div>

    @if (_summary is not null)
    {
        <div class="chip-row">
            <span class="chip"><Icon Name="IconName.Content" Size="14" /> @_summary.Value.subject</span>
            <span class="chip"><Icon Name="IconName.Teacher" Size="14" /> پایه @_summary.Value.grade</span>
            <span class="chip"><Icon Name="IconName.Lesson" Size="14" /> @_summary.Value.topic</span>
            <span class="chip"><Icon Name="IconName.Time" Size="14" /> @_summary.Value.duration.ToPersianDigits() دقیقه</span>
        </div>
    }

    <TeachingPackageView @ref="_view" Package="_package" OnCompleted="ReloadPackageAsync" />
}
else
{
    <div class="page-head">
        <div class="grow">
            <h1>@_package.LessonTitle</h1>
            <p class="page-sub">بسته آموزشی درس</p>
        </div>
        <a class="btn ghost" href="/lessons">محتوای من <Icon Name="IconName.ArrowRight" Size="16" /></a>
    </div>

    <TeachingPackageView @ref="_view" Package="_package" OnCompleted="ReloadPackageAsync" />
}

@code {
    [Parameter] public int Id { get; set; }

    private TeachingPackageDto? _package;
    private TeachingPackageView? _view;
    private string? _error;
    private (string subject, string grade, string topic, int duration)? _summary;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _package = await Api.GetLessonAsync(Id);
            if (_package is null)
            {
                _error = "درس یافت نشد.";
            }
            else if (_package.Progress.Status == "ready")
            {
                var lessons = await Api.GetLessonsAsync();
                var match = lessons?.FirstOrDefault(l => l.Id == Id);
                if (match is not null)
                {
                    _summary = (match.Subject, match.Grade, match.Topic, match.DurationMinutes);
                }
            }
        }
        catch (MadreseAIApiException ex)
        {
            _error = ex.Message;
        }
    }

    protected override Task OnAfterRenderAsync(bool _)
    {
        if (_package is not null && _package.Progress.Status is "generating" or "draft")
        {
            _view?.StartPolling();
        }

        return Task.CompletedTask;
    }

    private async Task ReloadPackageAsync()
    {
        var fresh = await Api.GetLessonAsync(Id);
        if (fresh is not null) _package = fresh;

        if (_summary is null)
        {
            var lessons = await Api.GetLessonsAsync();
            var match = lessons?.FirstOrDefault(l => l.Id == Id);
            if (match is not null)
            {
                _summary = (match.Subject, match.Grade, match.Topic, match.DurationMinutes);
            }
        }
    }
}
