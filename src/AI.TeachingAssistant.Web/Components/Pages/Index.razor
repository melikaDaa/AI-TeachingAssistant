@page "/"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inject MadreseAIApiClient Api
@inject AuthenticationStateProvider Authentication

<PageTitle>مدرس‌یار — داشبورد</PageTitle>

<section class="hero">
    <div class="hero-text">
        <h1>سلام، @_teacherName 👋</h1>
        <p class="hero-question">برای کلاس بعدیت چی آماده کنیم؟</p>
        <p>
            شرایط کلاست را بگو تا یک جلسه آموزشی متناسب با پایه، زمان و سطح دانش‌آموزانت طراحی کنیم.
        </p>
        <div class="hero-cta-group">
            <a class="btn big ai" href="@ProtectedLink("/lessons/new?mode=lesson")">
                <Icon Name="IconName.Sparkle" Size="18" /> طراحی یک جلسه
            </a>
            <a class="btn big ghost" href="@ProtectedLink("/lessons")">
                محتوای من <Icon Name="IconName.ArrowLeft" Size="16" />
            </a>
        </div>
    </div>
    <div class="hero-art" aria-hidden="true">
        <img src="assets/madrese-assistant.png" alt="" />
    </div>
</section>

<div class="section-header">
    <h2>قابلیت‌ها</h2>
</div>
<div class="feature-grid">
    <a class="feature-card" href="@ProtectedLink("/lessons/new?mode=lesson")">
        <span class="feature-icon"><Icon Name="IconName.Book" Size="22" /></span>
        <h3>طراحی یک جلسه</h3>
        <p>یک جلسه آموزشی کامل و منسجم با هدف، فعالیت، ارزشیابی و تکلیف.</p>
        <span class="feature-cta">طراحی جلسه <Icon Name="IconName.ArrowLeft" Size="14" /></span>
    </a>
    <a class="feature-card" href="@ProtectedLink("/lessons/new?mode=activity")">
        <span class="feature-icon"><Icon Name="IconName.Activity" Size="22" /></span>
        <h3>ساخت فعالیت</h3>
        <p>فعالیت تعاملی کلاسی با دستورالعمل اجرا و وسایل لازم.</p>
        <span class="feature-cta">ساخت فعالیت <Icon Name="IconName.ArrowLeft" Size="14" /></span>
    </a>
    <a class="feature-card" href="@ProtectedLink("/lessons/new?mode=quiz")">
        <span class="feature-icon"><Icon Name="IconName.Quiz" Size="22" /></span>
        <h3>ساخت آزمون</h3>
        <p>آزمون چهارگزینه‌ای و کوتاه با پاسخ‌نامه و توضیحات.</p>
        <span class="feature-cta">ساخت آزمون <Icon Name="IconName.ArrowLeft" Size="14" /></span>
    </a>
</div>

<div class="section-header">
    <h2>قابلیت‌های بیشتر</h2>
</div>
<div class="feature-grid">
    <div class="coming-soon-card">
        <span class="feature-icon"><Icon Name="IconName.AI" Size="22" /></span>
        <h3>دستیار شخصی معلم</h3>
        <p>دستیار هوشمند که سبک تدریس و نیازهای شما را بهتر می‌شناسد.</p>
        <span class="coming-soon-badge"><span class="dot"></span> به‌زودی</span>
    </div>
    <div class="coming-soon-card">
        <span class="feature-icon"><Icon Name="IconName.Book" Size="22" /></span>
        <h3>کتابخانه آموزشی</h3>
        <p>ساخت و مدیریت یک کتابخانه شخصی از محتوای آموزشی.</p>
        <span class="coming-soon-badge"><span class="dot"></span> به‌زودی</span>
    </div>
    <div class="coming-soon-card">
        <span class="feature-icon"><Icon Name="IconName.Star" Size="22" /></span>
        <h3>تحلیل کلاس</h3>
        <p>بینش هوشمند درباره عملکرد و پیشرفت دانش‌آموزان.</p>
        <span class="coming-soon-badge"><span class="dot"></span> به‌زودی</span>
    </div>
    <div class="coming-soon-card">
        <span class="feature-icon"><Icon Name="IconName.Content" Size="22" /></span>
        <h3>ساخت برگه تمرین</h3>
        <p>ساخت خودکار برگه تمرین و فعالیت کلاسی.</p>
        <span class="coming-soon-badge"><span class="dot"></span> به‌زودی</span>
    </div>
    <div class="coming-soon-card">
        <span class="feature-icon"><Icon Name="IconName.Sparkle" Size="22" /></span>
        <h3>شخصی‌سازی محتوا</h3>
        <p>تولید محتوای متناسب با سطح و نیاز دانش‌آموز.</p>
        <span class="coming-soon-badge"><span class="dot"></span> به‌زودی</span>
    </div>
    <div class="coming-soon-card">
        <span class="feature-icon"><Icon Name="IconName.Video" Size="22" /></span>
        <h3>ساخت ارائه</h3>
        <p>ساخت ارائه آموزشی با کمک AI.</p>
        <span class="coming-soon-badge"><span class="dot"></span> به‌زودی</span>
    </div>
</div>

<div class="section-header" style="margin-top: var(--space-8)">
    <h2>آخرین محتوا</h2>
    @if (_isAuthenticated && _lessons is { Count: > 0 })
    {
        <a class="section-link" href="/lessons">مشاهده همه <Icon Name="IconName.ArrowLeft" Size="15" /></a>
    }
</div>

@if (!_isAuthenticated)
{
    <div class="empty">
        <span class="big"><img src="assets/madrese-assistant.png" alt="" style="width:80px;height:80px" /></span>
        <h2>برای دیدن محتوای شخصی وارد شوید</h2>
        <p>صفحه اصلی و معرفی امکانات برای همه در دسترس است. برای ساخت یا مشاهده محتوای خود وارد حساب شوید.</p>
        <a class="btn" href="/account/login">ورود</a>
        <a class="btn ghost" href="/account/register">ساخت حساب</a>
    </div>
}
else if (_lessons is null)
{
    <div class="empty"><span class="big"><Icon Name="IconName.Loader" Size="26" CssClass="spin" /></span>در حال بارگذاری...</div>
}
else if (_lessons.Count == 0)
{
    <div class="empty">
        <span class="big"><img src="assets/madrese-assistant.png" alt="" style="width:80px;height:80px" /></span>
        <h2>هنوز محتوایی نساخته‌اید</h2>
        <p>اولین محتوای آموزشی‌ات را با کمک من بساز.</p>
        <a class="btn" href="/lessons/new"><Icon Name="IconName.Plus" Size="17" /> ساخت اولین محتوا</a>
    </div>
}
else
{
    <div class="grid">
        @foreach (var lesson in _lessons.Take(4))
        {
            <a class="lesson-row" href="@($"/lessons/{lesson.Id}")">
                <span class="card-icon" style="pointer-events:none; padding:.6rem; border-radius:var(--radius)" aria-hidden="true">
                    <span style="width:2.2rem; height:2.2rem; display:inline-flex; align-items:center; justify-content:center; background:var(--primary-50); color:var(--primary); border-radius:var(--radius-sm)">
                        <Icon Name="IconName.Lesson" Size="18" />
                    </span>
                </span>
                <span class="grow">
                    <h3>@lesson.Title</h3>
                    <div class="meta">
                        <span>@lesson.Subject</span>
                        <span>·</span>
                        <span>پایه @lesson.Grade</span>
                        <span>·</span>
                        <span><Icon Name="IconName.Time" Size="14" /> @lesson.DurationMinutes.ToPersianDigits() دقیقه</span>
                    </div>
                </span>
                <span class="badge @DtoMapper.StatusKey(lesson.Status)">@PersianText.StatusLabel(DtoMapper.StatusKey(lesson.Status))</span>
            </a>
        }
    </div>
}

@code {
    private List<LessonSummaryDto>? _lessons;
    private string _teacherName = "معلم عزیز";
    private bool _isAuthenticated;

    protected override async Task OnInitializedAsync()
    {
        _isAuthenticated = (await Authentication.GetAuthenticationStateAsync()).User.Identity?.IsAuthenticated == true;
        if (!_isAuthenticated) return;

        try
        {
            var teacher = await Api.GetTeacherAsync();
            if (teacher is not null)
            {
                var first = teacher.FullName.Split(' ')[0];
                _teacherName = first.Length > 0 ? first : "معلم عزیز";
            }
        }
        catch
        {
        }

        try { _lessons = await Api.GetLessonsAsync() ?? new(); }
        catch { _lessons = new(); }
    }

    private string ProtectedLink(string target) => _isAuthenticated ? target : $"/account?returnUrl={Uri.EscapeDataString(target)}";
}
