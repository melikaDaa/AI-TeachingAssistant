@page "/profile"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject MadreseAIApiClient Api

<PageTitle>مدرس‌یار — پروفایل</PageTitle>

<h1><Icon Name="IconName.Teacher" Size="24" CssClass="icon-title" /> پروفایل معلم</h1>
<p class="page-sub">این مشخصات به‌صورت خودکار در تولید محتوا استفاده می‌شود.</p>

@if (_error is not null)
{
    <div class="error-banner">@_error</div>
}
@if (_saved)
{
    <div class="edit-note" style="background:var(--success-light);color:var(--success-dark)">✓ پروفایل ذخیره شد.</div>
}

<section class="card usage-card" aria-labelledby="usage-title">
    <h2 id="usage-title">مصرف امروز</h2>
    @if (_usageLoading)
    {
        <p>در حال دریافت آمار مصرف…</p>
    }
    else if (_usage is not null)
    {
        <div class="usage-grid">
            <div class="usage-donut" style="--usage:@Percent(_usage.Text.Used, _usage.Text.Limit)%" role="img" aria-label="@Percent(_usage.Text.Used, _usage.Text.Limit) درصد مصرف متنی">
                <span>@Percent(_usage.Text.Used, _usage.Text.Limit)٪</span>
            </div>
            <div>
                <strong>تولید متن و درس</strong>
                <p>@_usage.Text.Used از @_usage.Text.Limit واحد · باقی‌مانده @_usage.Text.Remaining</p>
                <div class="usage-bar"><span style="width:@Percent(_usage.Text.Used, _usage.Text.Limit)%"></span></div>
                <strong>تولید تصویر</strong>
                <p>@_usage.Image.Used از @_usage.Image.Limit واحد · باقی‌مانده @_usage.Image.Remaining</p>
                <div class="usage-bar image"><span style="width:@Percent(_usage.Image.Used, _usage.Image.Limit)%"></span></div>
                <small>بازنشانی: @_usage.ResetsAtUtc.ToLocalTime().ToString("HH:mm")</small>
            </div>
        </div>
        @if (Percent(_usage.Text.Used, _usage.Text.Limit) >= _usage.WarningPercent)
        {
            <p class="usage-warning">بخش زیادی از ظرفیت امروز مصرف شده است؛ سهمیه در زمان اعلام‌شده دوباره در دسترس خواهد بود.</p>
        }
        <h3>تفکیک عملیات</h3>
        @foreach (var item in _usage.Operations)
        {
            <div class="usage-operation"><span>@OperationLabel(item.Key)</span><span>@item.Value</span></div>
        }
    }
    else if (_usageError is not null) { <p class="error-banner">@_usageError</p> }
</section>

@if (_loaded)
{
    <div class="card">
        <div class="field">
            <label for="fullname">نام و نام خانوادگی *</label>
            <input id="fullname" type="text" @bind-value="_fullName" @bind-value:event="oninput" />
        </div>

        <div class="form-row">
            <div class="field">
                <label for="level">مقطع *</label>
                <select id="level" @bind="_level">
                    @foreach (var l in TeachingLevels.All)
                    {
                        <option value="@l">@l</option>
                    }
                </select>
            </div>
            <div class="field">
                <label for="grade">پایه *</label>
                <input id="grade" type="text" @bind-value="_grade" @bind-value:event="oninput" />
            </div>
        </div>

        <div class="field">
            <label for="subjects">دروس تدریسی *</label>
            <input id="subjects" type="text" @bind-value="_subjects" @bind-value:event="oninput" placeholder="مثلاً: علوم تجربی" />
        </div>

        <div class="field">
            <label for="style">سبک تدریس *</label>
            <select id="style" @bind="_style">
                @foreach (var s in new[] { "تعاملی", "سخنرانی", "پروژه‌محور", "آزمایشی", "روایی" })
                {
                    <option value="@s">@s</option>
                }
            </select>
        </div>

        <button type="button" class="btn" @onclick="Save" disabled="@_saving">
            <Icon Name="IconName.Save" Size="16" /> ذخیره پروفایل
        </button>
    </div>
}
else
{
    <div class="empty"><span class="big"><Icon Name="IconName.Loader" Size="26" CssClass="spin" /></span>در حال بارگذاری...</div>
}

@code {
    private bool _loaded;
    private bool _saved;
    private bool _saving;
    private bool _usageLoading = true;
    private UsageDto? _usage;
    private string? _usageError;
    private string? _error;

    private string _fullName = string.Empty;
    private string _level = TeachingLevels.MiddleSchool;
    private string _grade = string.Empty;
    private string _subjects = string.Empty;
    private string _style = "تعاملی";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var teacher = await Api.GetTeacherAsync();
            if (teacher is not null)
            {
                _fullName = teacher.FullName;
                _level = teacher.Level;
                _grade = teacher.Grade;
                _subjects = teacher.Subjects;
                _style = teacher.TeachingStyle;
            }
            _loaded = true;
            _usage = await Api.GetUsageAsync();
        }
        catch (MadreseAIApiException ex)
        {
            _error = ex.Message;
            _loaded = true;
            _usageError = ex.Message;
        }
        finally { _usageLoading = false; }
    }

    private static int Percent(int used, int limit) => limit <= 0 ? 0 : Math.Clamp((int)Math.Round(100d * used / limit), 0, 100);
    private static string OperationLabel(string key) => key switch
    {
        "lesson-plan" => "طرح درس", "content" => "محتوای آموزشی", "activity" => "فعالیت کلاسی", "quiz" => "آزمون",
        "regenerate" => "تولید مجدد", "image" => "تصویر", "video-prompt" => "پرامپت ویدئو", _ => "سایر"
    };

    private async Task Save()
    {
        _error = null;
        _saved = false;
        _saving = true;
        try
        {
            await Api.UpdateTeacherAsync(new UpdateTeacherRequest
            {
                FullName = _fullName,
                Level = _level,
                Grade = _grade,
                Subjects = _subjects,
                TeachingStyle = _style,
            });
            _saved = true;
        }
        catch (MadreseAIApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}
