@page "/lessons/new"
@inject MadreseAIApiClient Api
@inject NavigationManager Nav

<PageTitle>مدرس‌یار — ساخت محتوای آموزشی</PageTitle>

<div class="steps">
    <div class="step @(_step >= 1 ? "active" : "") @(_step > 1 ? "done" : "")">
        <span class="n">۱</span> اطلاعات کلاس
    </div>
    <div class="step @(_step == 2 ? "active" : "")">
        <span class="n">۲</span> انتخاب محتوا
    </div>
</div>

@if (_step == 1)
{
    <div class="page-head">
        <div class="grow">
            <h1><Icon Name="IconName.AI" Size="26" CssClass="icon-title" /> با کمک مدرس‌یار یک درس می‌سازیم</h1>
            <p class="page-sub">چند اطلاعات کوتاه درباره کلاس وارد کنید؛ مدرس‌یار همان‌طور که می‌شناسد، محتوای متناسب می‌سازد.</p>
        </div>
    </div>

    <div class="ai-suggestion">
        <span class="ai-avatar"><Icon Name="IconName.Sparkle" Size="18" /></span>
        <div class="ai-text">
            <b>سلام! من مدرس‌یار هستم</b>
            <p>برای شروع، کمی درباره کلاس و درس خود به من بگویید. هرچه اطلاعات دقیق‌تری بدهید، محتوای بهتری می‌سازم.</p>
        </div>
    </div>

    @if (ModeTitle is not null)
    {
        <div class="mode-note" role="status">
            <Icon Name="@SectionMeta.IconOf(ModeSection)" Size="17" />
            <span>حالت انتخابی: <b>@ModeTitle</b> — پس از تکمیل اطلاعات، همین بخش به‌صورت پیش‌فرض انتخاب می‌شود. می‌توانید در مرحله بعد آن را تغییر دهید.</span>
            <a class="mode-note-link" href="/lessons/new?mode=lesson">جلسه کامل</a>
        </div>
    }

    @if (_error is not null)
    {
        <div class="error-banner" role="alert">
            <Icon Name="IconName.Bell" Size="17" /> @_error
        </div>
    }

    <div class="card">
        <h2 style="font-size:var(--text-lg)">اطلاعات درس</h2>
        <p class="page-sub" style="margin-bottom:1.2rem">این مشخصات دقیقاً همان چیزی است که هوش مصنوعی برای ساخت محتوا استفاده می‌کند.</p>

        <div class="form-row">
            <div class="field">
                <label for="title">عنوان درس *</label>
                <input id="title" type="text" @bind-value="_title" @bind-value:event="oninput" placeholder="مثلاً: سلول چیست؟" />
            </div>
            <div class="field">
                <label for="subject">نام درس *</label>
                <input id="subject" type="text" @bind-value="_subject" @bind-value:event="oninput" placeholder="مثلاً: علوم" />
            </div>
        </div>

        <div class="form-row">
            <div class="field">
                <label for="grade">پایه *</label>
                <input id="grade" type="text" @bind-value="_grade" @bind-value:event="oninput" placeholder="مثلاً: هفتم" />
            </div>
            <div class="field">
                <label for="topic">موضوع درس *</label>
                <input id="topic" type="text" @bind-value="_topic" @bind-value:event="oninput" placeholder="مثلاً: سلول" />
            </div>
        </div>

        <div class="form-row">
            <div class="field">
                <label for="duration">مدت جلسه (دقیقه) *</label>
                <input id="duration" type="number" min="15" max="240" step="5" @bind-value="_duration" @bind-value:event="oninput" />
            </div>
            <div class="field">
                <label for="level">سطح دانش‌آموزان *</label>
                <select id="level" @bind="_level">
                    <option value="مبتدی">مبتدی</option>
                    <option value="متوسط">متوسط</option>
                    <option value="پیشرفته">پیشرفته</option>
                </select>
            </div>
        </div>

        <details class="advanced-options">
            <summary><Icon Name="IconName.Settings" Size="16" /> گزینه‌های پیشرفته (اختیاری)</summary>
            <div class="advanced-options-body">
                <div class="form-row">
                    <div class="field">
                        <label for="studentCount">تعداد دانش‌آموزان</label>
                        <input id="studentCount" type="number" min="1" max="60" @bind-value="_studentCount" @bind-value:event="oninput" />
                    </div>
                    <div class="field">
                        <label for="sessionStyle">سبک جلسه</label>
                        <select id="sessionStyle" @bind="_sessionStyle">
                            <option value="">انتخاب کنید...</option>
                            <option value="مشارکتی">مشارکتی</option>
                            <option value="توضیح‌محور">توضیح‌محور</option>
                            <option value="بازی‌محور">بازی‌محور</option>
                            <option value="ترکیبی">ترکیبی</option>
                        </select>
                    </div>
                </div>
                <div class="field">
                    <label for="resources">امکانات موجود در کلاس</label>
                    <input id="resources" type="text" @bind-value="_resources" @bind-value:event="oninput" placeholder="مثلاً: تخته، ویدئوپروژکتور، کار گروهی" />
                </div>
            </div>
        </details>

        <h2 style="font-size:var(--text-lg); margin-top:1.5rem">یادداشت معلم</h2>
        <div class="field">
            <label for="instructions">توضیحات / محدودیت‌ها (اختیاری)</label>
            <textarea id="instructions" @bind-value="_instructions" @bind-value:event="oninput"
                      placeholder="مثلاً: دانش‌آموزان در این مبحث معمولاً حوصله ندارند."></textarea>
            <div class="hint">هر نکته‌ای که دوست دارید مدرس‌یار در ساخت همه بخش‌ها رعایت کند.</div>
        </div>

        <button type="button" class="btn big" @onclick="GoStep2">
            ادامه — انتخاب محتوا <Icon Name="IconName.ArrowLeft" Size="18" />
        </button>
    </div>
}

@if (_step == 2)
{
    <div class="page-head">
        <div class="grow">
            <h1>چه چیزی برای کلاس شما آماده کنم؟</h1>
            <p class="page-sub">می‌توانید همه موارد را یک‌جا بسازید یا فقط هر کدام را که لازم دارید انتخاب کنید.</p>
        </div>
    </div>

    <div class="chip-row" style="margin-top:0">
        <span class="chip"><Icon Name="IconName.Content" Size="14" /> @(_subject.Length > 0 ? _subject : "نام درس")</span>
        <span class="chip"><Icon Name="IconName.Teacher" Size="14" /> @(_grade.Length > 0 ? $"پایه {_grade}" : "پایه")</span>
        <span class="chip"><Icon Name="IconName.Lesson" Size="14" /> @(_topic.Length > 0 ? _topic : "موضوع")</span>
        <span class="chip"><Icon Name="IconName.Time" Size="14" /> @_duration.ToPersianDigits() دقیقه</span>
        <span class="chip">سطح @_level</span>
        <button type="button" class="btn ghost small" @onclick="() => _step = 1"><Icon Name="IconName.Edit" Size="14" /> ویرایش</button>
    </div>

    @if (_error is not null)
    {
        <div class="error-banner" role="alert">
            <Icon Name="IconName.Bell" Size="17" /> @_error
        </div>
    }

    <label class="select-all @(IsFullPackage ? "selected" : "")">
        <input type="checkbox" checked="@IsFullPackage" @onclick="ToggleFullPackage" />
        <div>
            <b>ساخت محتوای کامل کلاس</b><br />
            <span>طرح درس + محتوای آموزشی + فعالیت + آزمون + پرامپت تصویر + پرامپت ویدئو</span>
        </div>
    </label>

    <div class="selector-grid">
        @foreach (var s in SectionMeta.All)
        {
            var selected = _selected.Contains(s.Code);
            <label class="select-card @(selected ? "selected" : "")">
                <input type="checkbox" checked="@selected" @onclick="() => ToggleSection(s.Code)" />
                <div>
                    <span class="emoji"><Icon Name="@SectionMeta.IconOf(s.Code)" Size="17" /></span>
                    <b>@s.Title</b>
                    <span>@SectionHint(s.Code)</span>
                </div>
            </label>
        }
    </div>

    <div class="section-toolbar" style="margin-top:1.4rem">
        <button type="button" class="btn ghost big" @onclick="() => _step = 1">بازگشت</button>
        <span class="spacer"></span>
        <button type="button" class="btn big ai" disabled="@(!_selected.Any() || _generating)" @onclick="Generate">
            @if (_generating)
            {
                <Icon Name="IconName.Loader" Size="18" CssClass="spin" />
                <text>در حال آماده‌سازی...</text>
            }
            else
            {
                <Icon Name="IconName.Sparkle" Size="18" />
                <text>ساخت محتوای آموزشی</text>
            }
        </button>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "mode")]
    public string? Mode { get; set; }

    private int _step = 1;
    private bool _generating;

    private string _title = string.Empty;
    private string _subject = string.Empty;
    private string _grade = string.Empty;
    private string _topic = string.Empty;
    private int _duration = 60;
    private string _level = "متوسط";
    private int? _studentCount;
    private string? _sessionStyle;
    private string? _resources;
    private string _instructions = string.Empty;

    private HashSet<int> _selected = new() { 1, 2, 3, 4, 5, 6 };

    private string? _error;

    private bool IsFullPackage => _selected.Count == SectionMeta.All.Count;

    private int ModeSection => _mode switch
    {
        "content" => 2,
        "activity" => 3,
        "quiz" => 4,
        "image-prompt" => 5,
        "video-prompt" => 6,
        _ => 1,
    };

    private string? ModeTitle => _mode switch
    {
        "activity" => "ساخت فعالیت کلاسی",
        "quiz" => "ساخت آزمون",
        "content" => "ساخت محتوای آموزشی",
        "image-prompt" => "ساخت پرامپت تصویر",
        "video-prompt" => "ساخت پرامپت ویدئو",
        _ => null,
    };

    private string _mode = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _mode = (Mode ?? string.Empty).Trim().ToLowerInvariant();
        _selected = _mode switch
        {
            "content" => new HashSet<int> { 2 },
            "activity" => new HashSet<int> { 3 },
            "quiz" => new HashSet<int> { 4 },
            "image-prompt" => new HashSet<int> { 5 },
            "video-prompt" => new HashSet<int> { 6 },
            _ => new HashSet<int> { 1, 2, 3, 4, 5, 6 },
        };

        var teacher = await Api.GetTeacherAsync();
        if (teacher is not null)
        {
            _grade = teacher.Grade;
            _subject = teacher.Subjects
                .Split('،', ',')
                .Select(s => s.Trim())
                .FirstOrDefault(s => s.Length > 0 && s != "و") ?? string.Empty;
        }
    }

    private void GoStep2()
    {
        _error =
            string.IsNullOrWhiteSpace(_title) ? "لطفاً عنوان درس را وارد کنید." :
            string.IsNullOrWhiteSpace(_subject) ? "لطفاً نام درس را وارد کنید." :
            string.IsNullOrWhiteSpace(_grade) ? "لطفاً پایه تحصیلی را وارد کنید." :
            string.IsNullOrWhiteSpace(_topic) ? "لطفاً موضوع درس را وارد کنید." :
            _duration is < 15 or > 240 ? "لطفاً مدت کلاس را بین ۱۵ تا ۲۴۰ دقیقه مشخص کنید." :
            null;
        if (_error is null) _step = 2;
    }

    private static string SectionHint(int code) => code switch
    {
        1 => "برنامه دقیق کلاس با زمان‌بندی",
        2 => "توضیح آماده برای تدریس",
        3 => "فعالیت تعاملی قابل اجرا",
        4 => "۵ گزینه‌ای + ۳ کوتاه با پاسخ‌نامه",
        5 => "۲ پرامپت برای ابزار تولید تصویر",
        6 => "۱ پرامپت برای ابزار تولید ویدئو",
        _ => string.Empty,
    };

    private void ToggleFullPackage()
    {
        _selected = IsFullPackage
            ? new HashSet<int>()
            : new HashSet<int>(SectionMeta.All.Select(s => s.Code));
        _error = null;
    }

    private void ToggleSection(int code)
    {
        if (!_selected.Remove(code))
        {
            _selected.Add(code);
        }
        _error = null;
    }

    private async Task Generate()
    {
        _error = null;
        if (_selected.Count == 0)
        {
            _error = "لطفاً حداقل یک نوع محتوا انتخاب کنید.";
            return;
        }

        _generating = true;
        try
        {
            var created = await Api.CreateLessonAsync(new CreateLessonRequest
            {
                Title = _title,
                Subject = _subject,
                Grade = _grade,
                Topic = _topic,
                DurationMinutes = _duration,
                StudentLevel = _level,
                StudentCount = _studentCount,
                SessionStyle = string.IsNullOrWhiteSpace(_sessionStyle) ? null : _sessionStyle,
                AvailableResources = string.IsNullOrWhiteSpace(_resources) ? null : _resources,
                AdditionalInstructions = string.IsNullOrWhiteSpace(_instructions) ? null : _instructions,
                RequestedSections = _selected.OrderBy(x => x).ToList(),
            });

            await Api.StartGenerationAsync(created!.Id);

            Nav.NavigateTo($"/lessons/{created.Id}");
        }
        catch (MadreseAIApiException ex)
        {
            _error = ex.Message;
            _generating = false;
        }
    }
}
